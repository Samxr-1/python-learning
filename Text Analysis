class TextAnalyzer(object):
    def __init__ (self, text):
        raw_text = text.replace('.','').replace('!', '').replace(',','').replace('?','')
        raw_text = raw_text.lower()
        self.fmtText = raw_text
        
    def freqAll(self):        
        wordList = self.fmtText.split()
        Wordfreq = {}
        for word in set(wordList):
            Wordfreq[word] = wordList.count(word)
        return Wordfreq
           
    def freqOf(self,word):
        freqDict = self.freqAll()

        if word in freqDict:
            return freqDict[word]
        else:
            return 0

givenText = input("Enter a text: ")
analyzer = TextAnalyzer(givenText)
print("Formatted Text: ", analyzer.fmtText)
print("Word Frequencies: ", analyzer.freqAll())
print("Frequency of 'the': ", analyzer.freqOf('the'))
