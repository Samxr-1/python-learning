# ----------------------------- String

name = "Samer Aridi" 
print(name[0])  # OUTPUT: S
print(name[1])  # OUTPUT: a
print(name[-1]) # OUTPUT: i

print(name[0:3]) # OUTPUT: Sam
print(name[::2]) # OUTPUT (skips letter): SmrAii
