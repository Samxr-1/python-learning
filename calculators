while True:
    def add_numbers(a, b):
        return a + b

    def subtract_numbers(a, b):
        return a - b

    def multiply_numbers(a, b):
        return a * b

    def divide_numbers(a, b):
        try:
            return a / b
        except ZeroDivisionError:
            print("Error: Cannot divide by zero.")
            return None

    print("------------------------------------------------")
    print("Simple Calculator")
    print("------------------------------------------------")
    try:
        num1 = float(input("Enter the first number: "))
    except ValueError:
        print("Error: Please enter a valid number.")
        continue


    print("Select operation:")
    print("1. Add")
    print("2. Subtract")
    print("3. Multiply")
    print("4. Divide")
    try:
        choice = input("Enter choice (1/2/3/4): ")
    except ValueError:
        print("Error: Please enter a valid choice.")
        continue

    try:
        num2 = float(input("Enter the second number: "))
    except ValueError:
        print("Error: Please enter a valid number.")
        continue

    if choice == '1':
        sum_result = add_numbers(num1, num2)
        print(f"The result of addition is: {sum_result}")
    elif choice == '2':
        diff_result = subtract_numbers(num1, num2)
        print(f"The result of subtraction is: {diff_result}")
    elif choice == '3':
        prod_result = multiply_numbers(num1, num2)
        print(f"The result of multiplication is: {prod_result}")
    elif choice == '4':
        div_result = divide_numbers(num1, num2)
        print(f"The result of division is: {div_result}")
