# Reading Files with Open ------------------------------

  file1 = open("/resources/data/Example1.txt", "r")
  # |    |       |_ file directory  |_file name |_mode('r': reading, 'w': writing, 'a': appending)      } file path         
  # |    |_ open function
  # |_ file object

  file1.read()
  file1.open  # opens the file
  file1.name  # Print the path of filee
  file1.mode # prints mode
  file1.close() # closes the file

  # with statements ----
    with open("Example1.txt","r") as file1:   # better because it closes the file automatically 
      file_stuff=file1.read()  if you put x number it will read the x characters and print them on one line
      print(file_stuff)
    print(file1.closed)
    print(file_stuff)

  with open("Example1.txt","r") as file1:
    file_stuff=file1.readlines()   # reads line one and stores it in he variable file_stuff
    print(file_stuff)

  with open("Example1","r") as file1
    for line in file1:
      print(line)

